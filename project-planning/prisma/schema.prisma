generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Employe
  Client
}

enum Location {
  MERIGNAC
  LA_REOLE
}

enum ScheduleStatus {
  Prevue
  En_cours
  Terminee
  Annulee
}

enum ClientVisibility {
  visible
  hidden
}

enum InvoiceStatus {
  A_payer
  Payee
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String
  first_name          String
  email               String    @unique
  password            String? // hashed
  role                Role
  job                 String?
  phone_number        String?
  address             String?
  failed_attempts     Int       @default(0)
  last_failed_attempt DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  entry_date          DateTime? @db.Date
  location            Location  @default(MERIGNAC)
  disabled            Boolean   @default(false)

  // Relations
  schedulesAsEmployee Schedule[]          @relation("EmployeeSchedules")
  schedulesAsClient   Schedule[]          @relation("ClientSchedules")
  invoices            Invoice[]
  ClientServiceRate   ClientServiceRate[]
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  taux_tva    Decimal @default(20.00) @db.Decimal(5, 2)

  events      Schedule[]
  items       InvoiceItem[]
  clientRates ClientServiceRate[]
}

model Schedule {
  id                Int              @id @default(autoincrement())
  employee_id       Int
  client_id         Int
  date              DateTime         @db.Date
  start_time        DateTime         @db.Time
  end_time          DateTime         @db.Time
  service_id        Int
  status            ScheduleStatus
  client_visibility ClientVisibility @default(visible)
  notes             String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  taux_applique     Decimal?         @db.Decimal(10, 2)
  factured          Boolean          @default(false)

  // FKs
  employee    User         @relation("EmployeeSchedules", fields: [employee_id], references: [id], onDelete: Cascade)
  client      User         @relation("ClientSchedules", fields: [client_id], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [service_id], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem?

  @@index([employee_id])
  @@index([client_id])
  @@index([service_id])
  @@index([factured])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  numero        String        @unique // ex: FAC-2025-001
  client_id     Int
  date_emission DateTime      @db.Date
  date_echeance DateTime      @db.Date
  periode_debut DateTime      @db.Date
  periode_fin   DateTime      @db.Date
  montant_ht    Decimal       @db.Decimal(10, 2)
  montant_tva   Decimal       @default(0.00) @db.Decimal(10, 2)
  montant_ttc   Decimal       @db.Decimal(10, 2)
  taux_tva      Decimal       @default(20.00) @db.Decimal(5, 2)
  status        InvoiceStatus @default(A_payer)
  notes         String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  client User          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  items  InvoiceItem[]

  @@index([client_id], name: "idx_client")
  @@index([numero], name: "idx_numero")
  @@index([status], name: "idx_status")
}

model InvoiceItem {
  id              Int      @id @default(autoincrement())
  invoice_id      Int
  schedule_id     Int      @unique
  description     String
  date_prestation DateTime @db.Date
  heures          Decimal  @db.Decimal(5, 2)
  taux_horaire    Decimal  @db.Decimal(10, 2)
  montant_ht      Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now())
  taux_tva        Decimal  @default(20.00) @db.Decimal(5, 2)
  montant_tva     Decimal  @default(0.00) @db.Decimal(10, 2)
  montant_ttc     Decimal  @default(0.00) @db.Decimal(10, 2)

  invoice   Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  schedule  Schedule @relation(fields: [schedule_id], references: [id])
  Service   Service? @relation(fields: [serviceId], references: [id])
  serviceId Int?

  @@index([invoice_id], name: "idx_invoice")
}

model ClientServiceRate {
  id           Int      @id @default(autoincrement())
  client_id    Int
  service_id   Int
  taux_horaire Decimal  @db.Decimal(10, 2)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  client  User    @relation(fields: [client_id], references: [id], onDelete: Cascade)
  service Service @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([client_id, service_id], name: "unique_client_service")
}
